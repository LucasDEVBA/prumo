# Modo local (padrão): nada a configurar.
PRUMO_PROVIDER=simulated
PRUMO_STORAGE=memory
PRUMO_PROMPT_BACKEND=local

# Meta de qualidade e estatística
PRUMO_SLO_TARGET=0.85
PRUMO_ALPHA=0.05
PRUMO_METHOD=ppi_cs
PRUMO_REVIEW_RATE=0.05

# Opcional: exige o header X-Prumo-Token nas rotas que mudam estado
# PRUMO_ADMIN_TOKEN=

# Modo AWS (confira os IDs de modelo disponíveis na sua região no console do Bedrock)
# PRUMO_PROVIDER=bedrock
# PRUMO_STORAGE=dynamodb
# PRUMO_PROMPT_BACKEND=appconfig
# PRUMO_AWS_REGION=us-east-1
# PRUMO_BEDROCK_CLASSIFIER_MODEL=us.amazon.nova-lite-v1:0
# PRUMO_BEDROCK_JUDGE_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
